#!/bin/sh
# Launcher at project root (mandated name: credit_simulator).
# Builds the jar on first run, so a fresh clone works with no manual step.
DIR="$(cd "$(dirname "$0")" && pwd)"
find_jar() {
  ls -t "$DIR"/target/credit-simulator-*.jar 2>/dev/null | head -1
}
JAR="$(find_jar)"
if [ -z "$JAR" ]; then
  if ! command -v mvn >/dev/null 2>&1; then
    echo "Error: jar belum dibangun dan Maven tidak ditemukan. Install Maven 3.9+ lalu jalankan: mvn package" >&2
    exit 1
  fi
  echo "Membangun aplikasi (sekali saja)..." >&2
  (cd "$DIR" && mvn -q -DskipTests package) >&2 || exit 1
  JAR="$(find_jar)"
fi
exec java -jar "$JAR" "$@"
